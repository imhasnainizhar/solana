# -----------------------------------------------------------------------------
# Solana store — environment variables
# Copy to `.env` for local development. NEVER commit real values.
# -----------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------------
# Secret used by Payload to sign auth tokens / encrypt. Use a long random string
# in production (e.g. `openssl rand -hex 32`).
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres connection string. Locally: a plain Postgres. On Vercel: the Neon
# marketplace integration injects POSTGRES_URL / DATABASE_URL automatically —
# the app reads DATABASE_URI first, then POSTGRES_URL, then DATABASE_URL.
DATABASE_URI=postgres://postgres:postgres@localhost:5432/solana
# POSTGRES_URL=
# DATABASE_URL=

# Public URL of the site (no trailing slash). On Vercel this can be left unset;
# VERCEL_PROJECT_PRODUCTION_URL is used as a fallback server-side.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authorise draft-preview / live-preview links.
PREVIEW_SECRET=change-me-preview-secret

# --- Storage (Vercel Blob) ---------------------------------------------------
# When set, media uploads are stored in Vercel Blob; when empty, uploads are
# written to ./public/media (local dev only — Vercel's filesystem is read-only).
BLOB_READ_WRITE_TOKEN=

# --- Payments (Stripe, via @payloadcms/plugin-ecommerce) ---------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# --- Auth (planned: Google OAuth + email magic link; no passwords) -----------
# Placeholders — wired up in a later phase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP used to send magic-link sign-in emails (any SMTP provider, e.g. Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Solana Studio <no-reply@example.com>"

# --- Branding / SEO ----------------------------------------------------------
SITE_NAME="Solana Studio"
COMPANY_NAME="Solana Studio"
TWITTER_CREATOR=
TWITTER_SITE=
